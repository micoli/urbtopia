{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "good"
    },
    "$schema": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "pattern": "\\S"
        },
        "fr": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "string",
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "enum": [
        "construction",
        "food",
        "equipment",
        "luxury"
      ]
    },
    "recipe": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "durationMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unlockCitizens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "order",
    "name",
    "category",
    "recipe",
    "durationMinutes",
    "value",
    "unlockCitizens",
    "minTier"
  ],
  "additionalProperties": false,
  "title": "Good",
  "description": "A Good made by a Factory, one file per Good id in assets/defs/goods. Crop packs are derived from crops and pack formats."
}
