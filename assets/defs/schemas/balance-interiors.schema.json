{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buildings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "production",
              "service"
            ]
          },
          "layout": {
            "type": "object",
            "properties": {
              "gridSizes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "speedCaps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "yieldCaps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "technicianPosts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "required": [
              "gridSizes",
              "speedCaps",
              "yieldCaps",
              "technicianPosts"
            ],
            "additionalProperties": false
          },
          "roles": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "miller",
                "baker",
                "seller",
                "cheesemaker",
                "creamMaker",
                "stocker",
                "teacher",
                "librarian",
                "nurse",
                "doctor",
                "surgeon"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "part": {
                  "type": "string",
                  "enum": [
                    "speed",
                    "salesRate",
                    "cheeseYield",
                    "creamYield",
                    "capacity",
                    "schooling",
                    "knowledge",
                    "carePrimary",
                    "careDoctor",
                    "careSurgeon"
                  ]
                },
                "posts": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": [
                "part",
                "posts"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "family",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "buildings"
  ],
  "additionalProperties": false,
  "title": "Interiors balance",
  "description": "assets/defs/balance/interiors.json: the Production and Service interiors, their Staff roles, the posts by Tier and the part of the effect each role carries."
}
