{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "pattern": "\\S"
        },
        "fr": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "pattern": "\\S"
        },
        "fr": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "string",
      "enum": [
        "vitalSatisfaction",
        "wasteCoverage",
        "congestion",
        "greenShare",
        "citizens"
      ]
    },
    "target": {
      "type": "number",
      "minimum": 0
    },
    "holdDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "grant": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unlockCitizens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "name",
    "description",
    "metric",
    "target",
    "holdDays",
    "grant",
    "unlockCitizens"
  ],
  "additionalProperties": false,
  "title": "Objective",
  "description": "An Objective the State sets, one file per Objective id in assets/defs/objectives."
}
