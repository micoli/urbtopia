{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "road": {
      "type": "string",
      "pattern": "\\S",
      "modelId": true
    },
    "ramp": {
      "type": "string",
      "pattern": "\\S",
      "modelId": true
    },
    "span": {
      "type": "string",
      "pattern": "\\S",
      "modelId": true
    },
    "footbridge": {
      "type": "object",
      "properties": {
        "corridor": {
          "type": "string",
          "pattern": "\\S",
          "modelId": true
        },
        "corridorClosedWest": {
          "type": "string",
          "pattern": "\\S",
          "modelId": true
        },
        "corridorClosedEast": {
          "type": "string",
          "pattern": "\\S",
          "modelId": true
        },
        "deck": {
          "type": "string",
          "pattern": "\\S",
          "modelId": true
        },
        "stairLeft": {
          "type": "string",
          "pattern": "\\S",
          "modelId": true
        },
        "stairRight": {
          "type": "string",
          "pattern": "\\S",
          "modelId": true
        }
      },
      "required": [
        "corridor",
        "corridorClosedWest",
        "corridorClosedEast",
        "deck",
        "stairLeft",
        "stairRight"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "road",
    "ramp",
    "span",
    "footbridge"
  ],
  "additionalProperties": false,
  "title": "Bridge",
  "description": "assets/defs/infrastructure/bridge.json: the Model ids of the road of a bridge over water, of the ramp and the span of a bridge over infrastructure, and of the pieces of a Footbridge."
}
