{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "boardRadius": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deckSizes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "previewCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minorEdgeCounts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "rankScorePerHex": {
      "type": "object",
      "properties": {
        "bronze": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "silver": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gold": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "bronze",
        "silver",
        "gold"
      ],
      "additionalProperties": false
    },
    "sameCategoryScore": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "pairScores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "between": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "enum": [
                  "habitat",
                  "park",
                  "commerce",
                  "industry",
                  "service",
                  "water"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "habitat",
                  "park",
                  "commerce",
                  "industry",
                  "service",
                  "water"
                ]
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "score": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "between",
          "score"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "boardRadius",
    "deckSizes",
    "previewCount",
    "minorEdgeCounts",
    "rankScorePerHex",
    "sameCategoryScore",
    "pairScores"
  ],
  "additionalProperties": false,
  "title": "District plan balance",
  "description": "assets/defs/balance/districtPlan.json: the board of the District plan and the score of each pair of touching edges."
}
