{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "shapes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rows": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[#.]+$"
            }
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "shapes"
  ],
  "additionalProperties": false,
  "title": "Architect shapes",
  "description": "assets/defs/architect/shapes.json: the starting shapes of a house plan."
}
