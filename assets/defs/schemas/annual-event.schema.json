{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "pattern": "\\S"
        },
        "fr": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed"
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          },
          "required": [
            "kind",
            "month",
            "day"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "easter"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "weekdayInRange"
            },
            "weekday": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "from": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "to": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          },
          "required": [
            "kind",
            "weekday",
            "month",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "name",
    "anchor"
  ],
  "additionalProperties": false,
  "title": "Annual event",
  "description": "An Annual event of the calendar, one file per event id in assets/defs/annualEvents."
}
