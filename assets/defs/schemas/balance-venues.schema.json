        "dayHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dailyWage": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "hireFeeDays": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "managerYield": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frontBaseRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "frontRatePerHire": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "withoutSecurityRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "dayHours",
        "dailyWage",
        "hireFeeDays",
        "managerYield",
        "frontBaseRate",
        "frontRatePerHire",
        "withoutSecurityRate"
      ],
      "additionalProperties": false
    },
    "venue": {
      "type": "object",
      "properties": {
        "reachRadius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "playPrice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minPrice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPrice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "priceTolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "refundRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "reachRadius",
        "playPrice",
        "minPrice",
        "maxPrice",
        "priceTolerance",
        "refundRatio"
