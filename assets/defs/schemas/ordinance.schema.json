{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "pattern": "\\S"
        },
        "fr": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "pattern": "\\S"
        },
        "fr": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "unlockCitizens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "upkeepPerDay": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "popular": {
      "type": "boolean"
    },
    "exclusiveGroup": {
      "type": "string",
      "minLength": 1
    },
    "stances": {
      "type": "object",
      "properties": {
        "economy": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "environment": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "services": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        }
      },
      "required": [
        "economy",
        "environment",
        "services"
      ],
      "additionalProperties": false
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "taxMultiplier"
            },
            "multiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "multiplier"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wasteSorting"
            },
            "reduction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "reduction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "greenBelt"
            },
            "wellbeingBonus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "wellbeingBonus"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "transitSubsidy"
            },
            "congestionRelief": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "congestionRelief"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "energySaving"
            },
            "demandReduction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "demandReduction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "officeRelief"
            },
            "yieldMultiplier": {
              "type": "number",
              "exclusiveMinimum": 1
            }
          },
          "required": [
            "kind",
            "yieldMultiplier"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "culturalFestival"
            },
            "esteemBonus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "esteemBonus"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "name",
    "description",
    "unlockCitizens",
    "upkeepPerDay",
    "popular",
    "stances",
    "effect"
  ],
  "additionalProperties": false,
  "title": "Ordinance",
  "description": "An Ordinance the Mayor proposes to the Council, one file per Ordinance id in assets/defs/ordinances."
}
