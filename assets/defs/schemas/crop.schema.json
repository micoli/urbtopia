{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "crop"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "pattern": "\\S"
        },
        "fr": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "growthMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "water": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "yield": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seedShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seedPrice": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unlockCitizens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "packingMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "packedValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "models": {
      "type": "object",
      "properties": {
        "growth": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "string",
              "pattern": "\\S"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "produce": {
          "type": "string",
          "pattern": "\\S"
        },
        "harvested": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "growth"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "order",
    "name",
    "growthMinutes",
    "water",
    "yield",
    "seedShare",
    "seedPrice",
    "unlockCitizens",
    "packingMinutes",
    "packedValue",
    "models"
  ],
  "additionalProperties": false,
  "title": "Crop",
  "description": "A Crop species, one file per Crop id in assets/defs/crops. It is also a Material."
}
