          "required": [
            "active",
            "demonstrations",
            "election",
            "approvalWeighsOnGrants",
            "approvalWeighsOnCouncil"
          ],
          "additionalProperties": false
        },
        "easy": {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean"
            },
            "demonstrations": {
              "type": "boolean"
            },
            "election": {
              "type": "boolean"
            },
            "approvalWeighsOnGrants": {
              "type": "boolean"
            },
            "approvalWeighsOnCouncil": {
              "type": "boolean"
            }
          },
          "required": [
            "active",
            "demonstrations",
            "election",
            "approvalWeighsOnGrants",
            "approvalWeighsOnCouncil"
          ],
          "additionalProperties": false
        },
        "medium": {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean"
            },
            "demonstrations": {
              "type": "boolean"
            },
            "election": {
              "type": "boolean"
            },
            "approvalWeighsOnGrants": {
              "type": "boolean"
            },
            "approvalWeighsOnCouncil": {
              "type": "boolean"
            }
          },
          "required": [
            "active",
            "demonstrations",
            "election",
            "approvalWeighsOnGrants",
            "approvalWeighsOnCouncil"
          ],
          "additionalProperties": false
        },
        "hard": {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean"
            },
            "demonstrations": {
              "type": "boolean"
            },
            "election": {
              "type": "boolean"
            },
            "approvalWeighsOnGrants": {
              "type": "boolean"
            },
            "approvalWeighsOnCouncil": {
              "type": "boolean"
            }
          },
          "required": [
            "active",
            "demonstrations",
            "election",
            "approvalWeighsOnGrants",
            "approvalWeighsOnCouncil"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cozy",
        "easy",
        "medium",
        "hard"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "dayHours",
    "term",
    "adaptationDays",
    "council",
    "approval",
    "petitions",
    "objectives",
    "difficulties"
  ],
  "additionalProperties": false,
  "title": "Politics balance",
  "description": "assets/defs/balance/politics.json: Term, Council seats, Approval, Objectives, and what each Difficulty enables."
}
