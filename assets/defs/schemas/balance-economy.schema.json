{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tax": {
      "type": "object",
      "properties": {
        "urbsPerCitizenPerHour": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capHours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "urbsPerCitizenPerHour",
        "capHours"
      ],
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "fullPoints": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "floorPoints": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pointsLostPerUnit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recoveryMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "fullPoints",
        "floorPoints",
        "pointsLostPerUnit",
        "recoveryMinutes"
      ],
      "additionalProperties": false
    },
    "slotPrices": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\d+$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "rush": {
      "type": "object",
      "properties": {
        "priceFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minPrice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "priceFactor",
        "minPrice"
      ],
      "additionalProperties": false
    },
    "parcelPricing": {
      "type": "object",
      "properties": {
        "base": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "roundTo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "base",
        "factor",
        "roundTo"
      ],
      "additionalProperties": false
    },
    "shop": {
      "type": "object",
      "properties": {
        "stackSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "saleIntervalMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "stackSize",
        "saleIntervalMinutes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "tax",
    "market",
    "slotPrices",
    "rush",
    "parcelPricing",
    "shop"
  ],
  "additionalProperties": false,
  "title": "Economy balance",
  "description": "assets/defs/balance/economy.json: tax, market, Slot and Parcel prices, shops."
}
