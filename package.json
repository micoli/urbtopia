{
  "name": "urbtopia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender-guide.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/back-office",
    "lint": "eslint src build scripts tools",
    "test": "vitest run",
    "saves:update": "UPDATE_SAVES=1 vitest run src/saves",
    "assets": "node scripts/install-assets.ts",
    "models:rebuild": "python3 .claude/skills/create-building-model/scripts/rebuild_all.py",
    "predev": "npm run assets && npm run codex:generate && npm run avatars:generate",
    "prebuild": "npm run assets && npm run codex:generate && npm run avatars:generate",
    "codex:generate": "node scripts/generate-codex.ts",
    "avatars:generate": "node scripts/generate-avatars.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prestorybook": "npm run assets && npm run codex:generate && npm run avatars:generate",
    "prebuild-storybook": "npm run assets && npm run codex:generate && npm run avatars:generate",
    "test:storybook": "node scripts/storybook-smoke.ts",
    "defs:generate": "node scripts/generate-definitions.ts",
    "test:codex": "playwright test",
    "test:avatars": "vitest run scripts/avatarImages.test.ts",
    "test:codex:images": "vitest run scripts/codexImages.test.ts",
    "test:gameplay": "playwright test --config playwright.gameplay.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:guide": "playwright test --config playwright.guide.config.ts",
    "test:guide:update": "playwright test --config playwright.guide.config.ts --update-snapshots",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "assets:prototypes": "node scripts/prototype-assets.ts",
    "assets:editor": "vite --config tools/assets-editor/vite.config.ts --host",
    "back-office": "vite --config tools/back-office/vite.config.ts",
    "casino:sim": "vite --config prototypes/casino-sim/vite.config.ts --host",
    "preview": "vite preview",
    "check:bundle": "node scripts/checkBundle.ts dist",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:migrate": "docker compose run --rm migrate && docker compose restart rest",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:test": "docker compose --profile test run --rm pgtap",
    "db:types": "supabase gen types typescript --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres --schema public > src/persistence/cloud/database.types.ts && npx --yes oxfmt src/persistence/cloud/database.types.ts",
    "db:lint": "supabase db lint --fail-on error --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "lefthook": "^2.2.0",
    "radix-ui": "^1.7.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "intl-messageformat": "^12.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  }
}
